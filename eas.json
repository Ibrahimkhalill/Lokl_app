{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "node": "22.14.0",
      "corepack": true
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": "assembleRelease"
      },
      "environment": "preview",
      "channel": "preview",
      "node": "22.14.0",
      "corepack": true
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "channel": "production",
      "node": "22.14.0",
      "corepack": true
    }
  },
  "submit": {
    "production": {}
  }
}
